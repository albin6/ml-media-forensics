# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forensics_db
POSTGRES_USER=forensics_user
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://forensics_user:change_me_strong_password@postgres:5432/forensics_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=RS256

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_EVIDENCE_BUCKET=forensic-evidence
MINIO_RESULTS_BUCKET=forensic-results
MINIO_MODELS_BUCKET=forensic-models
MINIO_USE_SSL=false

# ─── ML Service (internal only) ───────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8001
ML_REQUEST_TIMEOUT_SECONDS=300

# ─── File Upload Constraints ──────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=2048
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/bmp,image/tiff
ALLOWED_VIDEO_TYPES=video/mp4,video/x-msvideo,video/quicktime

# ─── Security ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://forensics.yourdomain.com
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
